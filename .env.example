# Experimental option: Google's no-cost Maps Demo Key supports Maps, Places (New), and Compute Routes.
# For local evaluation only; hard Google quotas, no billing. A single demo key may fill both entries.
# Production option: billing-enabled project; enable Maps JavaScript API, Places API (New), Routes API.
# Private key: API restrictions = Places API (New), Routes API.
# Restrict to your server's public egress IP(s) where possible. NEVER make this key NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
# Separate browser key: API restriction = Maps JavaScript API; website/referrer restrictions.
# Development referrers: http://localhost:3000/* and http://127.0.0.1:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional real Google map ID. DEMO_MAP_ID is used only as Google's development map ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Enable only with a photo-capable paid-project Places key. Free demo keys do not include photos.
# Photo metadata joins the station search; media loads only when details are opened.
GOOGLE_MAPS_PHOTOS_ENABLED=false

# Manual charger verification experiment (server-only credentials).
# Create the agent with: npm run verification:agent -- --create
RETELL_API_KEY=
RETELL_AGENT_ID=
# An existing Retell-managed/imported outbound number with India calling enabled.
RETELL_FROM_NUMBER=
# Optional: choose a Hindi/English-capable voice with --voices, then set before --create.
RETELL_VOICE_ID=11labs-Adrian
MONGODB_URI=
MONGODB_DATABASE=evmap
# Cloudflare R2 S3 API credentials, scoped to the recording bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=evmap-recordings
